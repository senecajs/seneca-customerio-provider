{
  "name": "@seneca/customerio-provider",
  "version": "1.0.0",
  "main": "dist/customerio-provider.js",
  "type": "commonjs",
  "types": "dist/customerio-provider.d.ts",
  "description": "Seneca entity provider for the Customerio API.",
  "homepage": "https://github.com/senecajs/seneca-customerio-provider",
  "keywords": [
    "seneca",
    "customerio",
    "customerio-provider"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-customerio-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest --coverage",
    "test-nocov": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "clean": "rm -rf node_modules dist yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run repo-tag && npm publish --access public --registry https://registry.npmjs.org "
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "LICENSE",
    "CHANGES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "customerio-node": "^5.5.0"
  },
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "@seneca/env": "^0.6.0",
    "@seneca/provider": "^5.0.0",
    "seneca": "^4.0.0"
  },
  "devDependencies": {
    "@seneca/entity": "^29.0.0",
    "@seneca/env": "^0.6.0",
    "@seneca/provider": "^5.0.0",
    "@types/jest": "^29.5.4",
    "@types/node": "^24.13.3",
    "es-jest": "^2.1.0",
    "esbuild": "^0.19.2",
    "jest": "^29.6.4",
    "seneca": "^4.0.0",
    "seneca-msg-test": "^5.0.0",
    "typescript": "^5.2.2"
  },
  "peerDependenciesMeta": {
    "@seneca/env": {
      "optional": true
    }
  }
}
